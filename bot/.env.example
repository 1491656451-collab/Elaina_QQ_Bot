# ============ 复制本文件为 .env 后再修改 ============
DRIVER=~fastapi
HOST=127.0.0.1
PORT=8081

# 与 NapCat 里反向 WebSocket 填的 token 保持一致（强烈建议设置）
ONEBOT_ACCESS_TOKEN=改成一串随机字符

# 管理员 QQ（可用 /重载人设），可以写多个
SUPERUSERS=["你的大号QQ"]
# 机器人昵称：群里以这个名字开头说话也算“叫它”；只想 @ 才触发就留空
NICKNAME=[]
COMMAND_START=["/"]
LOG_LEVEL=INFO

# ============ DeepSeek ============
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：deepseek-flash（便宜快，推荐）/ deepseek-v4-pro（更聪明，贵约4倍）
DEEPSEEK_MODEL=deepseek-flash
# 调用超时（秒）；长期记忆整理用单独的 MEMORY_SUMMARY_TIMEOUT
# LLM_TIMEOUT=60
# 思考模式：聊天建议 false（开了更慢，且 temperature 不生效）
LLM_THINKING=false
LLM_TEMPERATURE=1.1
# 回复长度：讲故事/解释/倾诉等“长回复”上限，和日常闲聊上限（提示词要求闲聊约 10～30 字）
LONG_REPLY_MAX_TOKENS=200
SHORT_REPLY_MAX_TOKENS=80
# 对方一条消息最多取前多少字
MAX_INPUT_CHARS=300

# ============ 识图 ============
# 看懂对方发的图片 / 表情包；同一张图只看一次（结果缓存）
VISION_ENABLED=true
VISION_MAX_IMAGES=2
# 高峰时段也看图吗（默认不看，省钱）
VISION_IN_PEAK=false
# 本机角色识别：认出图里是不是伊蕾娜（免费，第一次启动自动下载约 470 MB 的模型）
VISION_TAGGER=true
# 误把别人认成伊蕾娜就调高（如 0.85），认不出就调低（如 0.6）
VISION_TAGGER_THRESHOLD=0.75
# 置信度在这个值～门槛之间（比如穿便服、没戴帽子的她）：让看图模型再确认一次是不是她；设成 1 就关掉
VISION_TAGGER_MAYBE=0.35
# 角色识别最多占几个 CPU 核。本机默认 2；搬到 2 核的服务器上请改成 1，免得识别那一两秒卡住 NapCat
VISION_TAGGER_THREADS=2
# 群里有人发伊蕾娜的图（没 @ 她）时，她也可能搭一句；概率和最短间隔（秒）
VISION_SELF_REACT=true
VISION_SELF_REACT_PROB=0.6
VISION_SELF_REACT_INTERVAL=600

# ============ 发表情包（用小号“收藏表情”里的伊蕾娜表情）============
# 在小号的收藏表情里存好伊蕾娜表情，连上 QQ 后自动拉取、自动打情绪标签；管理员用 /表情 查看和修改
STICKER_ENABLED=true
# 一轮回复可以带表情的概率（讨厌×0.5、陌生人×0.7、熟人×1、很熟×1.3）
STICKER_PROB=0.15
# 同一个群（私聊按人）两次表情最少隔几秒
STICKER_MIN_INTERVAL=180
# 有人发她的画像（斗图）时带表情的概率
STICKER_SELF_REACT_PROB=0.5
# 私聊也发
STICKER_PRIVATE=true
# 1 = 显示成表情样式（小图）；发出来显示不对就改成 -1，按普通图片发
STICKER_SUB_TYPE=1
# 一次最多拉多少张收藏；拉满了说明可能没拉全，那次不会把没见到的标成取消收藏
STICKER_FETCH_COUNT=500

# ============ 人设与记忆 ============
PERSONA_FILE=personas/elaina.md
# 记忆条数（一问一答算 2 条）：私聊 / 群聊
HISTORY_MAX_TURNS=20
HISTORY_MAX_TURNS_GROUP=10
GROUP_SHARED_MEMORY=true
PASSIVE_BUFFER=5

# ============ 长期记忆 ============
MEMORY_ENABLED=true
# 每轮对话都加进待整理，攒够这么多条就在后台整理一次
MEMORY_BATCH=8
# 每人档案最多几条 / 每个群往事最多几条（越多记得越多，每次回复多花一点 token）
MEMORY_MAX_FACTS=20
MEMORY_MAX_EVENTS=12
# 后台整理时模型最多写多少；写不下这次整理就作废，档案加长时这个也要跟着加
MEMORY_SUMMARY_MAX_TOKENS=4000
# 后台整理的超时（秒）；出错不自动重试，失败后隔 5 / 15 / 60 分钟再试
MEMORY_SUMMARY_TIMEOUT=180
# 每隔多少分钟检查一次有没有攒够一批却没整理的（开机时也查一次）；0 = 不查
MEMORY_RETRY_MINUTES=15

# ============ 主动插话（群里聊得正热时，她偶尔自己插一句）============
INTERJECT_ENABLED=true
# 每个群每天最多几次 / 两次至少隔几小时
INTERJECT_DAILY_MAX=2
INTERJECT_MIN_GAP_HOURS=3
# 只在这段时间插话（高峰时段也不插）
INTERJECT_HOURS=10:00-23:00
# 聊到她感兴趣 / 想吐槽的话题时看一眼的概率；别的话题的概率
INTERJECT_PROB=0.3
INTERJECT_OFFTOPIC_PROB=0.02

# ============ 冒泡（白名单群里很久没人说话时，她偶尔自己说一句）============
BUBBLE_ENABLED=true
# 多少小时没人说话才可能冒泡 / 每个群每天最多几次
BUBBLE_QUIET_HOURS=4
BUBBLE_DAILY_MAX=1
# 同一个群两次冒泡至少隔几小时 / 所有群加起来每天最多几次
BUBBLE_MIN_GAP_HOURS=36
BUBBLE_GLOBAL_DAILY_MAX=2
# 只在这段时间冒泡（高峰时段也不冒）
BUBBLE_HOURS=10:00-22:00

# ============ 没 @ 也回复（群聊）============
SMART_REPLY=true
# 她回完某人之后（从她最后一条发出算起），这个人多少秒内接着说的话直接算在跟她说
FOLLOWUP_WINDOW=60
# 同一个人分几条发时，先等一等，合成一条再回（每来一条新的重新计时）
# 看不出话说完没有时等几秒 / 看起来说完了（问号结尾等）等几秒 / 看起来没说完（“我跟你说”、逗号结尾、只叫了她一声）等几秒
MERGE_WAIT=4
MERGE_WAIT_COMPLETE=3
MERGE_WAIT_INCOMPLETE=8
# 从第一条算起最多等几秒
MERGE_WAIT_MAX=20
# 她正在回、或者回完多少秒内，对方单独补的一个表情算同一条消息，不单独回
STICKER_FOLLOW_SECONDS=20
# 对方只说“哈哈”“嗯”“好的”、发个表情时，她有时候不接话（越不熟越容易不接）
SKIP_FILLER=true
# 短消息让她自己判断要不要接话
SKIP_BY_MODEL=true
# 同一个群“没 @ 也回复”的最短间隔（秒）
SMART_MIN_INTERVAL=60

# ============ 小说知识库（摘要 + 原文检索）============
KNOWLEDGE_ENABLED=true
# 小说 txt 放在这个文件夹（相对 bot 文件夹，默认就是 D:\QQBot\novel）
KNOWLEDGE_NOVEL_DIR=../novel
# 相关度门槛：调高=更少提起小说内容，调低=更爱联想
KNOWLEDGE_MIN_SUMMARY_SCORE=14
KNOWLEDGE_MIN_CHUNK_SCORE=20
# 每次最多带几人的人物档案 / 几条梗概 / 几段原文
# KNOWLEDGE_TOP_CHARACTERS=2
# KNOWLEDGE_TOP_SUMMARIES=2
# KNOWLEDGE_TOP_CHUNKS=1

# ============ 好感度（决定她对人冷淡还是随意）============
# 分数 -100～100：光聊天默认不加分（见 AFFECTION_CHAT_GAIN）；长期记忆整理时按对话内容 +5～-15；7 天不聊开始每天回落 2 分
# 档位：低于 -20 讨厌（爱答不理）｜-20～29 陌生人｜30～69 熟人｜70 以上很熟
AFFECTION_DISLIKE=-20
AFFECTION_ACQUAINTANCE=30
AFFECTION_CLOSE=70
# 被讨厌的人叫她时，有多大概率直接不理
DISLIKE_IGNORE_PROB=0.4
# 直接当作“很熟”的 QQ 号
CLOSE_FRIENDS=[]
# 说她身材（平胸/飞机场等）立刻扣分；越熟越当成打闹，扣得越少
# TABOO_WORDS=["平胸","飞机场","贫乳","洗衣板","搓衣板","太平公主","没胸","胸小","胸平"]
TABOO_PENALTY=4
TABOO_DAILY_MAX=16
TABOO_TIER_MULTIPLIER={"disliked": 1.5, "stranger": 1.0, "acquaintance": 0.5, "close": 0.25}
# 送面包：每人每天只收一次，收下时加几分（讨厌的人送不加分）；说给钱不加好感
GIFT_BREAD_AFFECTION=2
# 光聊天加不加好感（0 = 不加，只看聊了什么）
AFFECTION_CHAT_GAIN=0
# AFFECTION_CHAT_GAIN 大于 0 时，靠光聊天每天最多涨几分
# AFFECTION_DAILY_CAP=5
# 多少天没聊开始回落、之后每天回落几分
# AFFECTION_DECAY_AFTER_DAYS=7
# AFFECTION_DECAY_PER_DAY=2
# 只有确认是女生才能到“很熟”（男生、没确认的最高到熟人）
GENDER_CAP=true
# 她质疑“真的假的？”之后，多少秒内对方再确认才算数
GENDER_CONFIRM_WINDOW=1800

# ---- 时间感 ----
# 对方隔了多少小时才来找她，就告诉她（熟人、很熟才会提）
GAP_NOTICE_HOURS=6
# 上一段聊天过去多少小时，就提醒她是新的一段对话
CONTEXT_STALE_HOURS=3

# ---- 主动写信（只写给“很熟”的 QQ 好友）----
LETTER_ENABLED=true
# 每个符合条件的人每天收到信的概率
LETTER_DAILY_PROB=0.25
# 同一个人两封信至少隔几天
LETTER_MIN_DAYS=3
# 对方至少多少小时没来找她才写
LETTER_MIN_SILENCE_HOURS=24
# 寄信时段（北京时间；高峰时段也不寄）
LETTER_HOURS=10:00-22:00
# 所有人合计每天最多几封
LETTER_MAX_PER_DAY=3

# ============ 私聊冷场后主动搭话 ============
# 她回完以后对方一阵子没回，她有几率自己再说一句（接着话题追问、随口问问、说点旅途小事）；对方一直不回也只搭一次
NUDGE_ENABLED=true
# 每次冷场搭话的概率，关系越好越高（讨厌的人不搭）
NUDGE_PROB={"disliked": 0.0, "stranger": 0.05, "acquaintance": 0.15, "close": 0.35}
# 对方多少分钟没回才可能搭话（在这两个数之间随机）
NUDGE_DELAY_MIN=5
NUDGE_DELAY_MAX=30
# 只在这段时间搭话（北京时间）；高峰时段也不搭
NUDGE_HOURS=09:00-23:30
# 每人每天最多几次 / 所有人合计每天最多几次
NUDGE_PER_USER_DAILY_MAX=2
NUDGE_DAILY_MAX=10

# ============ DeepSeek 高峰时段（北京时间工作日 9-12、14-18）============
# 高峰时她“很忙”：不主动接话，每人每 10 分钟最多一次正经回复，其余随机回“在忙”（不花钱）或不回
PEAK_ENABLED=true
# 2027 年起的法定节假日要自己补，例如 PEAK_HOLIDAYS=["2027-01-01","2027-01-02"]
PEAK_HOLIDAYS=[]
# 高峰时段（北京时间，仅周一至周五）和高峰时正经回复的长度上限
# PEAK_RANGES=09:00-12:00,14:00-18:00
# PEAK_MAX_TOKENS=50
PEAK_USER_INTERVAL=600
PEAK_BUSY_PROB=0.5

# ============ 触发范围（强烈建议先填白名单，只在自己的群测试）============
# 群聊总开关（关掉后群里完全不说话）
ENABLE_GROUP=true
ENABLE_PRIVATE=true
# 私聊只回好友，不回群临时会话
PRIVATE_FRIENDS_ONLY=true
GROUP_WHITELIST=[]
PRIVATE_WHITELIST=[]

# ============ 拟人：分条发送 ============
# 一次回复拆成几条消息发（最多 MAX_BUBBLES 条），多数消息末尾不带句号
MULTI_MESSAGE=true
MAX_BUBBLES=3

# ============ 风控 ============
USER_COOLDOWN=5
# 每小时限额（全局 / 每个群，各群分开算）；某个群或某个人用完时她只在那里说一句“我要上路了”再停下，全局用完才对最近聊过的都告别
GLOBAL_RATE_PER_HOUR=150
GROUP_RATE_PER_HOUR=40
# 每个人私聊每小时最多几条（各人分开算，用完只对这个人告别）
PRIVATE_RATE_PER_HOUR=30
FAREWELL_ON_LIMIT=true
# 全局限额用完时，这么多分钟内她说过话的群和私聊都会收到告别
FAREWELL_ACTIVE_MINUTES=10
# 小号被踢下线 / 和 NapCat 断开后，重新上线时私信管理员说明情况
OFFLINE_ALERT=true
# 被踢下线后重新上线，先安静几分钟：不回消息、不插话、不冒泡、不写信，之后补回这段时间的私聊；0 = 不安静
RELOGIN_QUIET_MINUTES=5
GLOBAL_RATE_PER_MINUTE=20
# 她自己说了“我要去赶路了”“先走了”之后，这么多分钟内真的不在（在两个数之间随机）；都设 0 就不管
LEAVE_MINUTES_MIN=20
LEAVE_MINUTES_MAX=60
# 回复前先“看消息、想一想”几秒，再按字数算打字时间
REPLY_DELAY_MIN=1.5
REPLY_DELAY_MAX=4.0
# 打字速度：每个字几秒（0.25 ≈ 每秒 4 个字）；想让她打字更慢就调大
REPLY_DELAY_PER_CHAR=0.25
# 拆成几条发时，两条之间先停顿几秒，再按下一条的字数算打字时间
BUBBLE_GAP_MIN=1.5
BUBBLE_GAP_MAX=3.5
# 回完一个人接着回另一个人时，中间停几秒（像切换聊天窗口）
SWITCH_GAP_MIN=2
SWITCH_GAP_MAX=5
# 每分钟限额满了时，最多排队等几秒再回（等不到才放弃）
QUEUE_MAX_WAIT=90

# ============ 未读消息（不在线时的私聊，上线后补回）============
CATCHUP_ENABLED=true
# 超过几小时的未读就不回了
CATCHUP_MAX_AGE_HOURS=12
# 一次上线最多补回几个人
CATCHUP_MAX_PEOPLE=5
# 补回两个人之间隔几秒
CATCHUP_GAP_MIN=20
CATCHUP_GAP_MAX=90

# ---- QQ 空间日记（每天一条说说：图 + 文案；回复说说下的评论）----
# 先私聊机器人 /空间测试 登录 等把接口测通，再改成 true
QZONE_ENABLED=false
# 每天在这段时间里随机挑一个时刻发
QZONE_POST_WINDOW=20:30-22:30
# 图库文件夹（放伊蕾娜的图）
QZONE_IMAGE_DIR=qzone/images
# 同一张图多少天内不重复
QZONE_IMAGE_REUSE_DAYS=60
# 回复评论；每隔多少分钟查一次；每天最多回几条
QZONE_COMMENT_REPLY=true
QZONE_COMMENT_POLL_MINUTES=120
QZONE_COMMENT_DAILY_MAX=10
# 别人在空间里 @ 她（说说里、评论里）也回
QZONE_MENTION_REPLY=true
# 熔断：空间一出现风控信号（限流、验证页），空间功能自动停几个小时，并私信管理员
QZONE_RISK_PAUSE_HOURS=24
# 机器人连上 NapCat 后多少分钟内不碰空间（每次在这两个数之间随机；刚上线就写空间容易被踢）
QZONE_STARTUP_GRACE_MINUTES=30
QZONE_STARTUP_GRACE_MAX_MINUTES=60
# 离上一条说说不到几小时，定时说说就跳过（凌晨手动发了一条，当晚照常发）
QZONE_POST_MIN_GAP_HOURS=12

# ============ 运行日志 ============
# 控制台的日志也按天存一份（data\logs\），事后能查“为什么没回”；留空就不存
LOG_FILE=data/logs/bot_{time:YYYY-MM-DD}.log
LOG_RETENTION_DAYS=14

# ============ 不理的人 ============
# 群里别的机器人之类，完全不理，免得两个机器人对着聊（Markdown、卡片消息本来就不理）
IGNORE_USERS=[]
